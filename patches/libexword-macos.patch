+int dict_reset(exword_t *device, char *user);
+
 struct state {
 	exword_t *device;
 	int mode;
@@ -636,8 +638,19 @@ void setpath(struct state *s)
 					printf("%s\n", exword_response_to_string(rsp));
 					exword_setpath(s->device, s->cwd, 0);
 				}
+			} else if (strncmp(path, "raw://", 6) == 0) {
+				/* path sent as-is, never creates dirs; "raw://" alone lists storage media */
+				rsp = exword_setpath(s->device, path + 6, 0);
+				if (rsp == 0x20) {
+					free(s->cwd);
+					s->cwd = xmalloc(strlen(path + 6) + 1);
+					strcpy(s->cwd, path + 6);
+				} else {
+					printf("%s\n", exword_response_to_string(rsp));
+					exword_setpath(s->device, s->cwd, 0);
+				}
 			} else {
-				printf("Invalid argument. Format (sd|mem)://<path>\n");
+				printf("Invalid argument. Format (sd|mem|raw)://<path>\n");
 			}
 		}
 	}
@@ -732,7 +745,9 @@ void interactive(struct state *s)
 		free(prompt);
 		prompt = create_prompt(s->cwd);
 		line = readline(prompt);
-		if (line == NULL || *line == '\0')
+		if (line == NULL)
+			break;
+		if (*line == '\0')
 			continue;
 		add_history(line);
 		fill_arg_list(&(s->cmd_list), line);
@@ -748,6 +763,7 @@ int main(int argc, const char** argv)
 {
 	struct state s;
 	setlocale(LC_ALL, "");
+	setvbuf(stdout, NULL, _IONBF, 0);
 	memset(&s, 0, sizeof(struct state));
 	interactive(&s);
 	return 0;
